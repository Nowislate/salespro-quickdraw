{
  "name": "salespro-quickdraw",
  "short_name": "Quickdraw",
  "description": "Sales-floor reference and trainer PWA. Edit data.js to customize for your brand.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4EFE3",
  "theme_color": "#1A1814",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
